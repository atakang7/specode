# Standalone Ollama runner; load with node --env-file=.env
SPECODE_MODEL=gemma2:2b
OLLAMA_BASE_URL=http://localhost:11434
SPECODE_VERBOSITY=medium
SPECODE_HTTP_TIMEOUT_MS=120000

# Core/Ink CLI only. The standalone runner ignores SPECODE_PROVIDER.
# Change SPECODE_MODEL when selecting a hosted model.
# SPECODE_PROVIDER=claude
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
