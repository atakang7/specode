# ── LLM Provider ────────────────────────────────────────────────────────────
# Which provider to use: claude | openai | ollama
SPECODE_PROVIDER=claude

# Optional: override the model for the selected provider
# Claude default:  claude-sonnet-4-6
# OpenAI default:  gpt-4o
# Ollama default:  gemma2:2b  (best schema+streaming support among small models)
# SPECODE_MODEL=claude-sonnet-4-6

# ── API Keys ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# ── Ollama (local models) ────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434

# ── CLI settings ────────────────────────────────────────────────────────────
# Default verbosity: low | medium | high
SPECODE_VERBOSITY=medium
